generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Photo {
  id          String   @id @default(uuid())
  storagePath String   @unique // where the file is in Storage
  label       String?  // "cat", "not_cat", or empty
  ground      String   // "training" or "testing"
  createdAt   DateTime @default(now())

  @@map("photos")
}

model TrainingRun {
  id        String   @id @default(uuid())
  rounds    Int      // epochs
  accuracy  Float    // 0 to 1
  modelUrl  String   // indexeddb://cat-lab-model
  createdAt DateTime @default(now())

  @@map("training_runs")
}
